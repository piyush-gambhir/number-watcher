{
  "version": 1,
  "name": "San Antonio number availability",
  "mode": "notify",
  "country": "US",
  "numberType": "local",
  "areaCodes": [
    "210",
    "726"
  ],
  "requiredCapabilities": [
    "voice",
    "sms"
  ],
  "quantity": 2,
  "pollIntervalSeconds": 300,
  "durationHours": 24,
  "providers": [
    {
      "type": "twilio",
      "accountSid": "AC00000000000000000000000000000000",
      "apiKeySidEnv": "TWILIO_API_KEY_SID",
      "apiKeySecretEnv": "TWILIO_API_KEY_SECRET"
    },
    {
      "type": "telnyx",
      "apiKeyEnv": "TELNYX_API_KEY"
    }
  ],
  "notifications": {
    "channels": [
      {
        "id": "operations-slack",
        "type": "slack",
        "webhookUrlEnv": "NUMBER_WATCHER_SLACK_WEBHOOK_URL"
      },
      {
        "id": "operations-email",
        "type": "email",
        "provider": "auto",
        "from": "numbers@example.com",
        "to": [
          "operations@example.com"
        ]
      }
    ]
  }
}
